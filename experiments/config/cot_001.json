{
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM",
    "target_modules": ["q_proj", "v_proj"]
  },
  "train": {
    "output_dir": "./experiments/model_001",
    "transformers_args": {
      "per_device_train_batch_size": 4,
      "gradient_accumulation_steps": 4,
      "num_train_epochs": 3,
      "learning_rate": 0.0002,
      "logging_steps": 10,
      "save_steps": 200,
      "save_total_limit": 1,
      "fp16": true,
      "bf16": false,
      "logging_dir": "./logs",
      "report_to": "none"
    }
  }
}